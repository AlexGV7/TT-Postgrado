{% extends 'base.html.twig' %}

{% block title %}403{% endblock %}

{% block body %}
    <div class="row justify-content-center align-items-center min-60-vh">
        <div class="col-lg-9"><div id="error-404" class="uc-card card-bg--gray">
            <div class="uc-card_body--xl"><div class="uc-subtitle">
                Error 403
            </div>
            <div class="h1 mb-24">
                Acceso denegado
            </div>
            <p>No tienes permiso para acceder a esta página. Si crees que es un error, por favor contacta al administrador.</p>
            <a href="{{ path('homepage') }}" class="uc-link text-weight--medium">
                Volver a la página de inicio <i class="uc-icon">keyboard_arrow_right</i>
            </a>
        </div>
    </div>
{% endblock %}
