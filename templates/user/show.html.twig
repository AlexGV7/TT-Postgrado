{% extends 'base.html.twig' %}

{% block title %}Usuario
{% endblock %}

{% block body %}
	<div class="d-flex align-items-center mb-24">
		<h1 class="mr-24">{{ user.name }} {{ user.lastName }}</h1>
		<img
			{% if user.getPicture == "https://intrawww.ing.puc.cl/siding/datos/fotos/publicas/" or user.getPicture == null %}
				src="{{asset('build/imgs/person_600dp_B7B7B7.png')}}"
			{% else %}
				src="{{ user.getPicture }}"
			{% endif %}
			class="profile-photo mr-12"
			alt="profile photo"
		/>
	</div>

	<table class="table">
		<tbody>
			<tr>
				<th>ID</th>
				<td>{{ user.id }}</td>
			</tr>
			<tr>
				<th>Email</th>
				<td>{{ user.email }}</td>
			</tr>
			<tr>
                                <th>Roles</th>
                                <td>
                                    {% if user.roles %}
                                        <ul>
                                            {% for role in user.getRolesTextArray %}
                                                <li>{{ role }}</li>
                                            {% endfor %}
                                        </ul>
                                    {% else %}
                                        No se han asignado roles
                                    {% endif %}
                                </td>
                            </tr>
			<tr>
				<th>Password</th>
				<td>{{ user.password }}</td>
			</tr>
			<tr>
				<th>DeactivatedNotifications</th>
				<td>{{ user.deactivatedNotifications ? 'Sí' : 'No' }}</td>
			</tr>
			<tr>
				<th>Sex</th>
				<td>{{ user.getSexText }}</td>
			</tr>
			<tr>
				<th>Rut</th>
				<td>{{ user.rut }}</td>
			</tr>
			<tr>
				<th>Name</th>
				<td>{{ user.name }}</td>
			</tr>
			<tr>
				<th>LastName</th>
				<td>{{ user.lastName }}</td>
			</tr>
			<tr>
				<th>Phone</th>
				<td>{{ user.phone }}</td>
			</tr>
			<tr>
				<th>Picture</th>
				<td>{{ user.picture }}</td>
			</tr>
		</tbody>
	</table>

	<div class="d-flex gap-2">
		{% if is_granted('ROLE_ADMIN') %}
			<a class="btn btn-secondary" href="{{ path('app_user_edit', {'id': user.id}) }}">Editar
				<i class="material-icons icon">edit</i>
			</a>
			<a class="btn btn-danger" href="{{ path('app_user_impersonate', {'id': user.id}) }}">Personificar
				<i class="material-icons icon">people_alt</i>
			</a>
			{{ include('user/_delete_form.html.twig') }}
		{% endif %}
	</div>
{% endblock %}
